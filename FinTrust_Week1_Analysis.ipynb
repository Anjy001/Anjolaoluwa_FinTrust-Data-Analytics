    "Average amount when risk = Yes:",
    round(
        risk_yes_amounts.mean(),
        2
    )
)


print(
    "Average amount when risk = No:",
    round(
        risk_no_amounts.mean(),
        2
    )
)


print(
    "T-value:",
    round(
        t_value,
        2
    )
)


print(
    "P-value:",
    amount_p_value
)


